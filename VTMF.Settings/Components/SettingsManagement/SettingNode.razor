@using VTMF.Settings.Models
@using VTMF.Settings.Entities
@using BlazorBootstrap

<ConfirmDialog @ref="deleteConfirmDialog" />
<div class="tree-node" style="margin-left: @(Node.Level * 20)px" @key="@Node.FullPath">
    <div class="node-content @GetNodeClass()">
        <div class="d-flex align-items-center w-100">
            <!-- Expand/Collapse Button (only for nodes with children) -->
            <div class="flex-shrink-0" style="width: 30px;">
                @if (Node.Children.Any())
                {
                    @if (Node.IsExpanded)
                    {
                        <i role="button" class="bi bi-caret-down" @onclick="ToggleExpanded"></i>
                    }
                    else
                    {
                        <i role="button" class="bi bi-caret-right" @onclick="ToggleExpanded"></i>
                    }
                }
                else
                {
                    <span class="node-spacer"><i role="button" class="bi bi-plus-circle-dotted" @onclick="AddNewChild"></i></span>
                }
                
            </div>

            <!-- Node Name - Fixed Width Column -->
            <div class="flex-shrink-0 text-truncate" style="width: 250px;" title="@Node.FullPath">
                <span class="fw-medium">
                    <span role="button" @onclick="@ToggleInfo">@Node.Name</span>
                    @if (Node.ParentIsGroup)
                    {
                        <i role="button" class="bi bi-dash-circle ms-2" @onclick="DeleteNode"></i>
                        <i role="button" class="bi bi-arrow-up-circle ms-2" @onclick="MoveNodeUp"></i>
                    }
                </span>
            </div>

            <!-- Node Value and Controls - Flexible Column -->
            @if (Node.IsLeaf && Node.Setting != null)
            {
                <div class="flex-grow-1 d-flex align-items-center gap-2">
                    <span class="node-separator text-muted">:</span>

                    @if (Node.IsEditing)
                    {
                        <div class="d-flex align-items-center gap-2 flex-grow-1">
                            @if (Node.Setting.ValueType == SettingValueType.Boolean)
                            {
                                <select class="form-control form-control-sm" style="max-width: 200px;" @bind="Node.EditValue" @onblur="SaveEdit">
                                    <option value="true">True</option>
                                    <option value="false">False</option>
                                </select>
                            }
                            else if (Node.Setting.ValueType == SettingValueType.Number)
                            {
                                <input type="number" class="form-control form-control-sm" style="max-width: 200px;" @bind="Node.EditValue" @onblur="SaveEdit" />
                            }
                            else if (Node.Setting.ValueType == SettingValueType.List && Node.Setting.Meta != null && Node.Setting.Meta.Values.Any())
                            {
                                <select class="form-control form-control-sm" style="max-width: 300px;" @bind="Node.EditValue" @onblur="SaveEdit">
                                    <option value="">-- Select Value --</option>
                                    @foreach (var val in Node.Setting.Meta.Values)
                                    {
                                        <option value="@val">@val</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input type="text" class="form-control form-control-sm" style="max-width: 300px;" @bind="Node.EditValue" @onblur="SaveEdit" />
                            }
                            
                            <button class="btn btn-sm btn-success" @onclick="SaveEdit">✓</button>
                            <button class="btn btn-sm btn-secondary" @onclick="CancelEdit">✗</button>
                            <button class="btn btn-sm btn-secondary" @onclick="DeleteSetting" title="Delete Setting">🗑️</button>"
                        </div>
                    }
                    else
                    {
                        <span class="node-value text-primary" style="cursor: pointer; min-width: 100px;" @onclick="StartEdit" title="Click to edit">
                            @(string.IsNullOrEmpty(Node.Setting.Value) ? "(empty)" : Node.Setting.Value)
                        </span>

                        
                        <!-- Badges and Buttons Container -->
                        <div class="d-flex align-items-center gap-1 ms-2">
                            <!-- ListSetting Indicator -->
                            @if (Node.Setting is ListSetting listSetting)
                            {
                                <span class="badge bg-warning text-dark" title="List Setting with @listSetting.SettingsCount items">
                                    List (@listSetting.SettingsCount)
                                </span>
                            }

                        </div>
                    }
                </div>
                
            }
        </div>
    </div>

    @if (Node.IsAddingNew)
    {
        <div class="card mt-2" style="margin-left: @(Node.Level * 20)px">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2">
                    <input type="text" class="form-control form-control-sm" style="max-width: 300px;" placeholder="Enter name..." @bind="Node.NewSettingName" />
                    <input type="text" class="form-control form-control-sm" style="max-width: 300px;" placeholder="Enter value..." @bind="Node.NewSettingValue" />
                    <button class="btn btn-sm btn-success" @onclick="SaveNewSetting">✓</button>
                    <button class="btn btn-sm btn-secondary" @onclick="CancelNewSetting">✗</button>
                </div>
            </div>
        </div>
    }

    <!-- Info Panel (shown when info button is clicked) -->
    @if (showInfo && Node.IsLeaf && Node.Setting != null)
    {
        <div class="card">
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-3">
                    <!-- BEGIN keep this -->
                    <button class="btn btn-sm btn-outline-secondary p-1" @onclick="CopyToClipboard" title="Copy to clipboard">
                        <i class="bi bi-clipboard"></i>
                    </button>
                    <span>@Node.Setting.Name => @Node.Setting.Value</span>
                    
                    <!-- END keep this -->
                </div>

                <div>
                    <!-- BEGIN keep this -->
                    @if (isEditingDescription)
                    {
                        <div class="mb-3">
                            <textarea class="form-control"
                                      rows="8"
                                      placeholder="Enter markdown here"
                                      @bind="editingDescriptionValue"
                                      @bind:event="oninput">
                            </textarea>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-sm btn-success" @onclick="SaveDescriptionEdit">✓ Save</button>
                            <button class="btn btn-sm btn-secondary" @onclick="CancelDescriptionEdit">✗ Cancel</button>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-start gap-2">
                            <button class="btn btn-sm btn-outline-secondary p-1" @onclick="StartEditingDescription" title="Edit description">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <div class="flex-grow-1">
                                @if (!string.IsNullOrEmpty(Node.Setting.Description))
                                {
                                    <Markdown>@Node.Setting.Description</Markdown>
                                }
                                else
                                {
                                    <span class="text-muted">(no description)</span>
                                }
                            </div>
                            
                        </div>
                    }
                    <!-- END keep this -->
                </div>

                @if (Node.Setting is ListSetting ls && ls.Settings.Any())
                {
                    <div class="mt-3">
                        <div class="fw-bold mb-2">List Items:</div>
                        <ul class="list-unstyled mb-0">
                            @foreach (var item in ls.Settings)
                            {
                                <li class="mb-1">
                                    <span class="badge bg-light text-dark">@item.Name</span> = @item.Value
                                </li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    }

    @if (showInfo && Node.Features.Any())
    {
        <div class="card">
            <div class="card-body">
                <FeatureList Features="Node.Features" OnApplyFeature="ApplyFeature" />
            </div>
        </div>
    }


    <!-- Child Nodes (shown when expanded) -->
    @if (Node.IsExpanded && Node.Children.Any())
    {
        <div class="child-nodes">
            @foreach (var child in Node.Children.OrderBy(c => c.Setting?.OrderNr ?? 0))
            {
                <SettingNode Node="@child"
                             OnValueChanged="@OnValueChanged"
                             OnToggleExpanded="@OnToggleExpanded"
                             OnLoadMetadata="@OnLoadMetadata"
                             OnStartEdit="@OnStartEdit"
                             OnDeleteSetting="@OnDeleteSetting"
                             OnLoadFeatures="@OnLoadFeatures"
                             OnApplyFeature="@OnApplyFeature"
                             OnDeleteNode="@OnDeleteNode"
                             OnAddNewChild="@OnAddNewChild"
                             OnMoveNodeUp="@OnMoveNodeUp"
                             OnSaveDescription="@OnSaveDescription" />
            }
        </div>
        
    }

    
</div>

